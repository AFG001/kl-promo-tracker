# ============================================================
# KL Electronics Promo Tracker — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Firebase / Firestore ---
# Path to the service account JSON key downloaded from Firebase Console
# (Project Settings → Service Accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json

# Your Firebase project ID (visible in Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Scraping ---
# How often to auto-scrape (hours). Default: 24
SCRAPE_INTERVAL_HOURS=24

# --- Server ---
HOST=0.0.0.0
PORT=8000
